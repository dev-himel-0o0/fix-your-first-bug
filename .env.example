# Public repository slug used by the contributors page and GitHub links.
NEXT_PUBLIC_GITHUB_REPO=dev-himel-0o0/fix-your-first-bug

# Canonical production URL used by metadata, the sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://fix-your-first-bug.vercel.app

# Optional. Raises the GitHub API rate limit for the contributors page.
# Never expose this value to the browser; it is only read on the server.
GITHUB_TOKEN=
